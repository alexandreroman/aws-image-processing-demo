# Copy this file to .env.local and adjust if needed.
# .env.local is gitignored.
#
# Overlay on top of .env, loaded ONLY by the host-mode dev and quality
# Make targets: `make dev`, `make backend`, `make worker`,
# `make frontend`, `make infra-up`, `make test`, `make check`.
#
# The compose stack (`make app-up`) does NOT read this file. It is
# self-contained: every constant is inlined in compose.yaml, and only
# ANTHROPIC_API_KEY is interpolated at compose time.
#
# AWS deploy targets (`make deploy`, `make frontend-deploy`,
# `make teardown`) ignore this file.

# --- AWS / Moto ------------------------------------------------------------
# Point the AWS SDK at the local Moto Server brought up by `make infra-up`.
# Real AWS credentials come from your CLI profile (`~/.aws/credentials`);
# Moto accepts whatever creds the SDK sends, so no overrides are needed here.
AWS_ENDPOINT_URL=http://localhost:4566

# Fixed resource names for host-mode dev. Keep them in sync with the
# values inlined in compose.yaml so both modes hit the same resources.
IMAGES_BUCKET=aws-image-processing-demo-images-local
IMAGES_TABLE=aws-image-processing-demo-images-local

# --- Temporal dev server ---------------------------------------------------
# Override Temporal Cloud with the local dev server brought up by
# `make infra-up`. Empty TLS material disables mTLS.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=
